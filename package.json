{
  "name": "dsh-markdown-link-preview",
  "version": "0.1.1",
  "description": "Open same-origin Markdown output links inside DSH Better Sidebar instead of an external app.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "markdown",
    "preview",
    "better-sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lukeknow0/dsh-markdown-link-preview.git"
  },
  "bugs": {
    "url": "https://github.com/Lukeknow0/dsh-markdown-link-preview/issues"
  },
  "homepage": "https://github.com/Lukeknow0/dsh-markdown-link-preview#readme",
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.13.0",
    "react": "^18.2.0"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.3.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "dsh-better-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  }
}
